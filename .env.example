# Copy to .env to override the defaults locally. .env is not versioned. No secret is needed.

# Quote API under test
QUOTE_API_BASE_URL=http://localhost:3000

# Start the API from api/ when it is not reachable (true/false)
QUOTE_API_AUTOSTART=true

# Versioned OpenAPI contract (default: api/openapi.json)
QUOTE_API_CONTRACT=

# Max wait for the health check after an auto start
QUOTE_API_STARTUP_TIMEOUT_SECONDS=30

# Timeout of one HTTP request
QUOTE_API_REQUEST_TIMEOUT_MS=10000
